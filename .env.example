# Copy this file to .env and fill in your values.
# Shown in the header, footer, titles, and page copy.
NEXT_PUBLIC_SITE_NAME=Milepost

# A file in public, such as /brand.png, or a full https image URL.
# Leave empty to keep the built-in mark.
NEXT_PUBLIC_LOGO_URL=

# Change this to the public https address before a production build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_URLS=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Set to false to ask AI crawlers to stay out.
ALLOW_AI_CRAWLERS=true
